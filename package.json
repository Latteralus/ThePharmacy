{
  "name": "thepharmacy",
  "version": "1.0.0",
  "main": "electron-main.js",
  "description": "Pharmacy management simulation game",
  "author": "Chris Barnett",
  "license": "MIT",
  "homepage": "https://github.com/Latteralus/ThePharmacy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Latteralus/ThePharmacy.git"
  },
  "bugs": {
    "url": "https://github.com/Latteralus/ThePharmacy/issues"
  },
  "scripts": {
    "build:ts": "tsc",
    "start": "npm run build:ts && electron .",
    "build": "electron-builder",
    "dist": "npm run build:ts && electron-builder --win --x64",
    "publish": "npm run build:ts && electron-builder --publish always",
    "test": "npm run build:ts && jest",
    "test:e2e": "npm run build:ts && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.latteralus.thepharmacy",
    "productName": "ThePharmacy",
    "files": [
      "electron-main.js",
      "preload.js",
      "game-integration.js",
      "index.html",
      "main.html",
      "settings.html",
      "main/**/*.js",
      "main/**/*.html",
      "main/**/*.css"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Latteralus",
        "repo": "ThePharmacy",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  }
}
