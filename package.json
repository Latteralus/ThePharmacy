{
  "name": "thepharmacy",
  "version": "1.0.0",
  "main": "electron-main.js",
  "description": "Pharmacy management simulation game",
  "author": "Chris Barnett",
  "license": "MIT",
  "homepage": "https://github.com/Latteralus/ThePharmacy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Latteralus/ThePharmacy.git"
  },
  "bugs": {
    "url": "https://github.com/Latteralus/ThePharmacy/issues"
  },
  "scripts": {
    "build:ts": "tsc",
    "start": "npm run build:ts && electron .",
    "build": "electron-builder",
    "dist": "npm run build:ts && electron-builder --win --x64",
    "publish": "npm run build:ts && electron-builder --publish always",
    "test": "npm run build:ts && jest",
    "test:e2e": "npm run build:ts && playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "electron": "^44.8.0",
    "electron-builder": "^26.17.0",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "knip": "^6.41.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.10"
  },
  "build": {
    "appId": "com.latteralus.thepharmacy",
    "productName": "ThePharmacy",
    "files": [
      "electron-main.js",
      "preload.js",
      "game-integration.js",
      "index.html",
      "main.html",
      "settings.html",
      "build/main/**/*.js",
      "main/**/*.css"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Latteralus",
        "repo": "ThePharmacy",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    }
  }
}
