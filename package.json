{
  "name": "thepharmacy",
  "version": "1.0.0",
  "main": "electron-main.js",
  "description": "Pharmacy management simulation game",
  "author": "",
  "license": "ISC",
  "homepage": "https://github.com/Latteralus/ThePharmacy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Latteralus/ThePharmacy.git"
  },
  "bugs": {
    "url": "https://github.com/Latteralus/ThePharmacy/issues"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --win --x64",
    "publish": "electron-builder --publish always",
    "test": "jest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.yourcompany.thepharmacy",
    "productName": "ThePharmacy",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Latteralus",
        "repo": "ThePharmacy",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  }
}
